SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/lunrea

# Optional. Leave blank in development: files are saved to ./uploads.
# Fill all four in production to store media in Cloudflare R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
CORS_ORIGINS=http://localhost:5173
